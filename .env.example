# ============================================================
# Consulte+ — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

APP_ENV=local

# Banco de Dados — Local
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=consulte

# Banco de Dados — Produção
PROD_DB_HOST=localhost
PROD_DB_USER=seu_usuario_producao
PROD_DB_PASS=sua_senha_producao
PROD_DB_NAME=nome_banco_producao

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_chave_supabase

# Asaas (Financeiro)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua_chave_asaas

# CRM API
CRM_API_KEY=sua_chave_crm
