RewriteEngine On
# RewriteBase será detectado automaticamente
RewriteBase /consulteplus/
# Em desenvolvimento: /cinco/
# Em produção: /

# Auth Routes
RewriteRule ^login/?$ login.php [L]
RewriteRule ^cadastro/?$ cadastro.php [L]
RewriteRule ^logout/?$ logout.php [L]

# Redirecionar para HTTPS (opcional, descomente se tiver SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# CORREÇÃO CRÍTICA PARA API (Bearer Token)
# Garante que o header Authorization chegue no PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Agendamento Online Público
RewriteRule ^agendar(.*)$ agend_online/index.php [L,QSA]
RewriteRule ^api/public/(.*)$ api/public/$1 [L,QSA]

RewriteRule ^relatorios/?$ modules/relatorios/index.php [L]
RewriteRule ^relatorios/atendimentos/?$ modules/relatorios/atendimentos.php [L]
RewriteRule ^relatorios/ociosidade/?$ modules/relatorios/ociosidade.php [L]
RewriteRule ^relatorios/produtividade/?$ modules/relatorios/produtividade.php [L]
RewriteRule ^relatorios/financeiro/?$ modules/relatorios/financeiro.php [L]

RewriteRule ^minhas-notificacoes/?$ modules/minhas-notificacoes/index.php [L]
RewriteRule ^notificacoes/?$ modules/notificacoes/index.php [L]
RewriteRule ^notificacoes/nova/?$ modules/notificacoes/nova.php [L]
RewriteRule ^notificacoes/editar/([0-9]+)/?$ modules/notificacoes/editar.php?id=$1 [L]
RewriteRule ^notificacoes/log/?$ modules/notificacoes/log.php [L]

RewriteRule ^configuracoes/?$ modules/configuracoes/index.php [L]
RewriteRule ^configuracoes/n8n/?$ modules/configuracoes/n8n.php [L]

RewriteRule ^documentacao/?$ modules/documentacao/index.php [L]

RewriteRule ^bloqueios/?$ modules/bloqueios/index.php [L]
RewriteRule ^bloqueios/novo/?$ modules/bloqueios/novo.php [L]
RewriteRule ^bloqueios/editar/([0-9]+)/?$ modules/bloqueios/editar.php?id=$1 [L]

RewriteRule ^prontuarios/?$ modules/prontuarios/index.php [L]
RewriteRule ^prontuarios/novo/([0-9]+)/?$ modules/prontuarios/novo.php?agendamento_id=$1 [L]
RewriteRule ^prontuarios/editar/([0-9]+)/?$ modules/prontuarios/editar.php?id=$1 [L]
RewriteRule ^prontuarios/([0-9]+)/?$ modules/prontuarios/visualizar.php?id=$1 [L]

# CRM (Cliente)
RewriteRule ^crm/?$ modules/crm/index.php [L,QSA]
RewriteRule ^crm/config/?$ modules/crm/config.php [L,QSA]
RewriteRule ^crm/acoes/?$ modules/crm/acoes.php [L,QSA]
RewriteRule ^crm/negocio/([0-9]+)/?$ modules/crm/detalhes.php?id=$1 [L,QSA]
RewriteRule ^crm/quadro/?([0-9]*)$ modules/crm/index.php?view=quadro&funil=$1 [L,QSA]
RewriteRule ^crm/lista/?([0-9]*)$ modules/crm/index.php?view=lista&funil=$1 [L,QSA]

# Atendimento (Cliente - Roteador Central)
RewriteRule ^atendimento/?(.*)$ index.php?url=atendimento/$1 [L,QSA]

# Marketing (Cliente)
RewriteRule ^marketing/?$ modules/marketing/index.php [L,QSA]
RewriteRule ^marketing/leads/?$ modules/marketing/leads/index.php [L,QSA]
RewriteRule ^marketing/leads/([0-9]+)/?$ modules/marketing/leads/ver.php?id=$1 [L,QSA]
RewriteRule ^marketing/audiencias/?$ modules/marketing/audiencias/index.php [L,QSA]
RewriteRule ^marketing/audiencias/acoes/?$ modules/marketing/audiencias/acoes.php [L,QSA]
RewriteRule ^marketing/gerador_leads/?$ modules/marketing/gerador_leads/index.php [L,QSA]
RewriteRule ^marketing/gerador_leads/acoes/?$ modules/marketing/gerador_leads/acoes.php [L,QSA]
RewriteRule ^marketing/import/?$ modules/marketing/import/index.php [L,QSA]

RewriteRule ^dashboard/?$ modules/dashboard/index.php [L]

RewriteRule ^pacientes/?$ modules/pacientes/index.php [L]
RewriteRule ^pacientes/novo/?$ modules/pacientes/novo.php [L]
RewriteRule ^pacientes/editar/([0-9]+)/?$ modules/pacientes/editar.php?id=$1 [L]
RewriteRule ^pacientes/([0-9]+)/?$ modules/pacientes/visualizar.php?id=$1 [L]

RewriteRule ^profissionais/?$ modules/profissionais/index.php [L]
RewriteRule ^profissionais/novo/?$ modules/profissionais/novo.php [L]
RewriteRule ^profissionais/editar/([0-9]+)/?$ modules/profissionais/editar.php?id=$1 [L]
RewriteRule ^profissionais/notificacoes/?$ modules/profissionais/notificacoes.php [L]
RewriteRule ^profissionais/([0-9]+)/?$ modules/profissionais/visualizar.php?id=$1 [L]

RewriteRule ^salas/?$ modules/salas/index.php [L]
RewriteRule ^salas/novo/?$ modules/salas/novo.php [L]
RewriteRule ^salas/editar/([0-9]+)/?$ modules/salas/editar.php?id=$1 [L]
RewriteRule ^salas/([0-9]+)/?$ modules/salas/visualizar.php?id=$1 [L]
RewriteRule ^salas/alocacao/?$ modules/salas/alocacao.php [L]
RewriteRule ^especialidades/?$ modules/especialidades/index.php [L]
RewriteRule ^especialidades/novo/?$ modules/especialidades/novo.php [L]
RewriteRule ^especialidades/editar/([0-9]+)/?$ modules/especialidades/editar.php?id=$1 [L]
RewriteRule ^especialidades/excluir/([0-9]+)/?$ modules/especialidades/excluir.php?id=$1 [L]

RewriteRule ^tipos-procedimento/?$ modules/tipos-procedimento/index.php [L]
RewriteRule ^tipos-procedimento/novo/?$ modules/tipos-procedimento/novo.php [L]
RewriteRule ^tipos-procedimento/editar/([0-9]+)/?$ modules/tipos-procedimento/editar.php?id=$1 [L]

RewriteRule ^alocacao/?$ modules/alocacao/index.php [L]
RewriteRule ^alocacao/nova/?$ modules/alocacao/nova.php [L]
RewriteRule ^alocacao/editar/([0-9]+)/?$ modules/alocacao/editar.php?id=$1 [L]


RewriteRule ^agendamentos/?$ modules/agendamentos/index.php [L]
RewriteRule ^agendamentos/calendario/?$ modules/agendamentos/calendario.php [L]
RewriteRule ^agendamentos/novo/?$ modules/agendamentos/novo.php [L]
RewriteRule ^agendamentos/confirmar-recorrente/?$ modules/agendamentos/confirmar-recorrente.php [L]
RewriteRule ^agendamentos/editar/([0-9]+)/?$ modules/agendamentos/editar.php?id=$1 [L]
RewriteRule ^agendamentos/([0-9]+)/?$ modules/agendamentos/visualizar.php?id=$1 [L]
RewriteRule ^agendamentos/series/?$ modules/agendamentos/series.php [L]
RewriteRule ^agendamentos/editar-serie/([a-zA-Z0-9-]+)/?$ modules/agendamentos/editar-serie.php?id=$1 [L]
RewriteRule ^agendamentos/cancelar-serie/([a-zA-Z0-9-]+)/?$ modules/agendamentos/cancelar-serie.php?id=$1 [L]

RewriteRule ^prontuarios/?$ modules/prontuarios/index.php [L]
RewriteRule ^prontuarios/novo/?$ modules/prontuarios/novo.php [L]
RewriteRule ^prontuarios/editar/([0-9]+)/?$ modules/prontuarios/editar.php?id=$1 [L]
RewriteRule ^prontuarios/([0-9]+)/?$ modules/prontuarios/visualizar.php?id=$1 [L]

RewriteRule ^notificacoes/?$ modules/notificacoes/index.php [L]
RewriteRule ^notificacoes/nova/?$ modules/notificacoes/nova.php [L]
RewriteRule ^notificacoes/editar/([0-9]+)/?$ modules/notificacoes/editar.php?id=$1 [L]
RewriteRule ^notificacoes/log/?$ modules/notificacoes/log.php [L]

RewriteRule ^relatorios/?$ modules/relatorios/index.php [L]
RewriteRule ^relatorios/atendimentos/?$ modules/relatorios/atendimentos.php [L]
RewriteRule ^relatorios/ociosidade/?$ modules/relatorios/ociosidade.php [L]
RewriteRule ^relatorios/produtividade/?$ modules/relatorios/produtividade.php [L]
RewriteRule ^relatorios/financeiro-dre/?$ modules/relatorios/financeiro_dre.php [L]

RewriteRule ^financeiro/?$ modules/financeiro/index.php [L]
RewriteRule ^financeiro/novo/?$ modules/financeiro/novo.php [L]
RewriteRule ^financeiro/editar/([0-9]+)/?$ modules/financeiro/editar.php?id=$1 [L]
RewriteRule ^financeiro/editar-serie/([^/]+)/?$ modules/financeiro/editar-serie.php?id=$1 [L]
RewriteRule ^financeiro/assinatura/?$ modules/financeiro/minha_assinatura.php [L]

RewriteRule ^configuracoes/?$ modules/configuracoes/index.php [L]
RewriteRule ^configuracoes/n8n/?$ modules/configuracoes/n8n.php [L]
RewriteRule ^configuracoes/agendamento-online/?$ modules/configuracoes/agendamento-online.php [L]
RewriteRule ^configuracoes/financeiro/?$ modules/configuracoes/financeiro.php [L]
RewriteRule ^configuracoes/tokens/?$ modules/configuracoes/tokens.php [L]

RewriteRule ^usuarios/?$ modules/usuarios/index.php [L]
RewriteRule ^usuarios/novo/?$ modules/usuarios/novo.php [L]
RewriteRule ^usuarios/editar/([0-9]+)/?$ modules/usuarios/editar.php?id=$1 [L]

RewriteRule ^minhas-notificacoes/?$ modules/minhas-notificacoes/index.php [L]
RewriteRule ^profissionais/notificacoes/?$ modules/profissionais/notificacoes.php [L]

RewriteRule ^gestao/?$ modules/gestao/index.php [L]
RewriteRule ^gestao/tarefas/?$ modules/gestao/tarefas/index.php [L]
RewriteRule ^gestao/tarefas/([0-9]+)/?$ modules/gestao/tarefas/detalhe.php?id=$1 [L,QSA]
RewriteRule ^gestao/tarefas/detalhe/?$ modules/gestao/tarefas/detalhe.php [L,QSA]
RewriteRule ^gestao/diagnostico/?$ modules/gestao/diagnostico/index.php [L]
RewriteRule ^gestao/diagnostico/novo/?$ modules/gestao/diagnostico/formulario.php [L]
RewriteRule ^gestao/diagnostico/resultado/?$ modules/gestao/diagnostico/resultado.php [L]
RewriteRule ^gestao/diagnostico/resultado/([0-9]+)/?$ modules/gestao/diagnostico/resultado.php?id=$1 [L]
RewriteRule ^gestao/diagnostico/roadmap/?$ modules/gestao/diagnostico/roadmap.php [L]
RewriteRule ^gestao/diagnostico/roadmap/([0-9]+)/?$ modules/gestao/diagnostico/roadmap.php?id=$1 [L]
RewriteRule ^gestao/planejamento/?$ modules/gestao/planejamento/index.php [L]
RewriteRule ^gestao/projetos/?$ modules/gestao/projetos/index.php [L]
RewriteRule ^gestao/projetos/novo/?$ modules/gestao/projetos/novo.php [L]
RewriteRule ^gestao/projetos/detalhe.php/?$ modules/gestao/projetos/detalhe.php [L,QSA]
RewriteRule ^gestao/projetos/([0-9]+)/?$ modules/gestao/projetos/detalhe.php?id=$1 [L,QSA]

# Admin Routes (Clean URLs)
RewriteRule ^admin/dashboard/?$ modules/admin/dashboard/index.php [L]
RewriteRule ^admin/usuarios/?$ modules/admin/usuarios/index.php [L]
RewriteRule ^admin/empresas/view/([0-9]+)/?$ modules/admin/empresas/view.php?id=$1 [L]
RewriteRule ^admin/empresas/?$ modules/admin/empresas/index.php [L]
RewriteRule ^admin/financeiro/nova-assinatura/?$ modules/admin/financeiro/nova_assinatura.php [L]
RewriteRule ^admin/financeiro/?$ modules/admin/financeiro/index.php [L]
RewriteRule ^admin/ferramentas/editar/([0-9]+)/?$ modules/admin/ferramentas/editar.php?id=$1 [L]
RewriteRule ^admin/ferramentas/editar/?$ modules/admin/ferramentas/editar.php [L,QSA]
RewriteRule ^admin/ferramentas/?$ modules/admin/ferramentas/index.php [L]



# Redirect Legacy Mentoria URLs (301 Permanent)
RedirectMatch 301 ^/consulteplus/admin/mentoria/(.*)$ /consulteplus/admin/produtos/$1
RedirectMatch 301 ^/consulteplus/admin/mentoria$ /consulteplus/admin/produtos
RedirectMatch 301 ^/consulteplus/mentoria/(.*)$ /consulteplus/produtos/$1
RedirectMatch 301 ^/consulteplus/mentoria$ /consulteplus/produtos

# Produtos (LMS - Mentoria, Cursos, etc)
RewriteRule ^admin/produtos/?$ modules/admin/produtos/index.php [L]
RewriteRule ^admin/produtos/produto/?$ modules/admin/produtos/produto.php [L,QSA]
RewriteRule ^admin/produtos/produto/([0-9]+)/?$ modules/admin/produtos/produto.php?id=$1 [L,QSA]
RewriteRule ^admin/produtos/trilhas/([0-9]+)/?$ modules/admin/produtos/trilhas.php?produto_id=$1 [L,QSA]
RewriteRule ^admin/produtos/trilhas/?$ modules/admin/produtos/trilhas.php [L,QSA]
RewriteRule ^admin/produtos/conteudo/([0-9]+)/?$ modules/admin/produtos/conteudo.php?id=$1 [L,QSA]
RewriteRule ^admin/produtos/conteudo/?$ modules/admin/produtos/conteudo.php [L,QSA]
RewriteRule ^admin/produtos/distribuir/([0-9]+)/?$ modules/admin/produtos/distribuir.php?id=$1 [L,QSA]
RewriteRule ^admin/produtos/distribuir/?$ modules/admin/produtos/distribuir.php [L,QSA]
RewriteRule ^admin/produtos/ia-generator/([0-9]+)/?$ modules/admin/produtos/ia_modulo_generator.php?produto_id=$1 [L,QSA]
RewriteRule ^admin/produtos/ia_generator/?$ modules/admin/produtos/ia_generator.php [L]
RewriteRule ^admin/produtos/ia_modulo_generator/?$ modules/admin/produtos/ia_modulo_generator.php [L,QSA]
RewriteRule ^admin/produtos/salvar_ia/?$ modules/admin/produtos/salvar_ia.php [L]

# Diagnósticos (Admin)
RewriteRule ^admin/diagnosticos/?$ modules/admin/diagnosticos/index.php [L]
RewriteRule ^admin/diagnosticos/perguntas/([0-9]+)/?$ modules/admin/diagnosticos/perguntas.php?modelo_id=$1 [L,QSA]
RewriteRule ^admin/diagnosticos/atribuir/?$ modules/admin/diagnosticos/atribuir.php [L]
RewriteRule ^admin/diagnosticos/novo/?$ modules/admin/diagnosticos/novo.php [L]
RewriteRule ^admin/diagnosticos/editar/([0-9]+)/?$ modules/admin/diagnosticos/editar.php?id=$1 [L]
RewriteRule ^admin/diagnosticos/criar_completo/?$ modules/admin/diagnosticos/criar_completo.php [L]
RewriteRule ^admin/diagnosticos/criar_ia/?$ modules/admin/diagnosticos/criar_ia.php [L]

RewriteRule ^produtos/?$ modules/produtos/index.php [L]
RewriteRule ^produtos/produto/([0-9]+)/?$ modules/produtos/produto.php?id=$1 [L]
RewriteRule ^produtos/aula/([0-9]+)/?$ modules/produtos/aula.php?id=$1 [L]

# Ferramentas Estratégicas
RewriteRule ^ferramentas/?$ modules/ferramentas/index.php [L]

# SWOT
RewriteRule ^ferramentas/swot/?$ modules/ferramentas/swot/index.php [L]
