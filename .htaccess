RewriteRule ^ferramentas/swot/editar/([0-9]+)/?$ modules/ferramentas/swot/form.php?id=$1 [L]
RewriteRule ^ferramentas/swot/excluir/?$ modules/ferramentas/swot/excluir.php [L,QSA]

